
#ifndef SECRETS_H
#define SECRETS_H

// ===============================
// Wi-Fi Configuration
// ===============================

#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"


// ===============================
// Firebase Configuration
// ===============================

// Firebase Realtime Database URL
// Example: https://your-project-default-rtdb.firebaseio.com

#define FIREBASE_DATABASE_URL "https://YOUR-PROJECT-default-rtdb.firebaseio.com"


// ===============================
// MQTT Configuration
// ===============================

// MQTT broker address
// Replace with your computer's local IP
// if using a local Mosquitto broker.

#define MQTT_BROKER "192.168.1.100"

#define MQTT_PORT 1883

#define MQTT_TOPIC "esp32s3/dht22/data"

#define MQTT_CLIENT_ID "ESP32S3_DHT22_CLIENT"


// ===============================
// Sensor Configuration
// ===============================

#define DHT_PIN 4
#define DHT_TYPE DHT22

#define SENSOR_INTERVAL 5000

#endif

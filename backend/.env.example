# Database (Neon Postgres)
DATABASE_URL="postgresql://username:password@ep-your-db-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-your-db.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="your-branch"
# In-memory mode is non-persistent and is disabled unless explicitly enabled.
# Only set true for a disposable local demo; never enable in production.
ALLOW_IN_MEMORY_DATABASE=false
# Demo fixture seeding is also opt-in and disabled in production.
SEED_DEMO_DATA=false
DB_DEBUG_TRANSACTIONS=false

# Neon Auth (Better Auth / JWKS)
NEON_AUTH_BASE_URL="https://your-neon-auth.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-neon-auth.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://your-storage.storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-2"
S3_BUCKET="assets"

# Neon Functions
NEON_FUNCTION_HELLO_BASE_URL="https://your-function.compute.us-east-2.aws.neon.tech"

# App & Server Configuration
PORT=4000
NODE_ENV="development"
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:3000"
IOT_INGEST_SECRET="replace-with-a-long-random-secret"
AIML_SERVICE_TOKEN="replace-with-a-long-random-token"
AIML_API_URL="http://localhost:8000"

# One-time administrator bootstrap. Set only immediately before running
# `npm run bootstrap:admin`, then remove these variables.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

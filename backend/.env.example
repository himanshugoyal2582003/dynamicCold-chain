# Database (Neon Postgres)
DATABASE_URL="postgresql://username:password@ep-your-db-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-your-db.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Neon Auth (Better Auth / JWKS)
NEON_AUTH_BASE_URL="https://your-neon-auth.neonauth.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-neon-auth.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3="https://your-storage.storage.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_access_key_id"
AWS_SECRET_ACCESS_KEY="your_secret_access_key"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="assets"

# Neon Functions
NEON_FUNCTION_HELLO_BASE_URL="https://your-function.compute.us-east-2.aws.neon.tech"

# App & Server Configuration
PORT=4000
NODE_ENV="development"
JWT_SECRET="56ca4198545a5a7ac03663c8e7194d4d366ca32cf93c17b8a6db56de5c3a9ee4a6954059968cda139b349e45c5e06173"
CORS_ORIGIN="http://localhost:3000"

{
  "name": "coldchain-backend",
  "version": "1.0.0",
  "description": "ColdChain Fleet Platform NestJS Backend with Neon Cloud Services",
  "author": "Elite Avengers",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test:neon": "ts-node src/test-neon.ts",
    "test:rescue": "npm run build && node --test scripts/rescue-unit.test.cjs scripts/rescue-integration.test.cjs",
    "test:maintenance": "npm run build && node --test scripts/maintenance-unit.test.cjs scripts/maintenance-integration.test.cjs",
    "evaluate:maintenance": "node scripts/evaluate-maintenance.cjs",
    "test:digital-twin": "npm run build && node --test scripts/digital-twin-unit.test.cjs scripts/digital-twin-integration.test.cjs",
    "db:init": "ts-node src/db/db-init.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "bootstrap:admin": "ts-node src/db/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@neondatabase/serverless": "^0.10.4",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/platform-socket.io": "^11.2.11",
    "@nestjs/websockets": "^11.2.11",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "jose": "^6.0.8",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pg-mem": "^3.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/socket.io": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
